---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const beliefs = [
  { title: "A kid's idea is a real idea.", body: 'If a ten year old wants to start a dog walking business, the right response is "what\'s your price?"' },
  { title: 'Critical thinking is a skill, not a trait.', body: 'You get better at it by using it on something you care about, over and over, with someone pushing back. That is the whole program.' },
  { title: 'Grit is teachable.', body: 'The first version is always bad. Kids who learn that early, with support, stop being afraid of it.' },
  { title: 'The tools are real and so are the stakes.', body: 'Actual software, actual materials, actual people to talk to. Nothing here is pretend, which is exactly why they take it seriously.' },
  { title: 'The kid drives.', body: "I don't pick the project and I don't pick the answer. I point at resources, teach the next skill, and ask the hard question at the right moment." },
  { title: 'Finish the thing.', body: 'Every learner leaves with something that exists in the world. That is the only outcome I care about.' },
];

const faqs = [
  { q: 'Who is this for?', a: 'Kids ages 6 to 14 who have something they want to make, start, or figure out. Cohorts are split into narrow age bands (6 to 8, 9 to 11, 12 to 14) that meet on different days.' },
  { q: 'What does a week look like?', a: 'Two guided sessions with the cohort, plus open makerspace hours they can drop into to work on their project, use the gear, and be around other kids who are building. Between sessions they keep up their critical thinking journal, at least one entry a week.' },
  { q: 'Where is it?', a: 'In person, in San Francisco, in a makerspace style setting. Exact location details go out to families on the waitlist first.' },
  { q: 'What does it cost?', a: 'Tuition is not set yet for the next cohort. I will send pricing to the waitlist before applications open, so nobody is surprised.' },
  { q: 'How do applications work?', a: 'The kid applies. A parent fills in the logistics, but the application itself comes from the learner, in their own words. Spaces are limited and I do turn families down. The goal is a room full of kids who want to be there.' },
  { q: 'Is this a coding program? An AI thing?', a: 'No. Some kids will build software because their idea needs it. Others will build a product, a business, a campaign, a game. The constant is critical thinking, skills they will use for the rest of their lives, and finishing.' },
  { q: 'Why are you the right person to teach this?', a: 'Because I have done both halves. I have built education programs for kids in New York and San Francisco, and I have run ecommerce and the full tech stack at a nine-figure skincare company and at B2B and manufacturing companies. Today I work with B2B companies at the eight-figure Series B and C stage. I know what a real build takes and I know how to teach it, and that combination is rare.' },
  { q: 'Will my kid be on social media?', a: 'Never by face or name. I build this in public and share the work, but you will only ever see hands and blurred projects. Kids are referred to by role, like "this inventor," never by name.' },
  { q: 'What happens at the end?', a: 'A showcase. Each learner puts their finished thing in front of people who take it seriously, and the strongest work earns things like a company visit, a workshop, or for the older band, an internship conversation. The showcase is just the day it becomes real to everyone else. The building is what matters.' },
];
---
<Base title="About" current="about" description="What AB Combinator is, what I believe, and the questions parents ask. A San Francisco cohort for kids ages 6 to 14 who want to build something real.">
  <section class="intro">
    <div class="wrap intro-inner">
      <p class="kicker">About</p>
      <h1>A place where kids build real things.</h1>
      <p class="lede">
        AB Combinator is a cohort for kids ages 6 to 14 who have an idea and want it to exist. I teach the critical thinking and the skills. They do the building.
      </p>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <h2>Six things I'm not flexible on.</h2>
      <ol class="beliefs">
        {beliefs.map((b, i) => (
          <li>
            <span class="belief-num">{i + 1}</span>
            <div>
              <h3>{b.title}</h3>
              <p class="soft">{b.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section>
    <div class="wrap two-col">
      <div>
        <p class="kicker">What it actually is</p>
        <h2>A cohort, a journal, and a room full of tools.</h2>
      </div>
      <div class="stack">
        <p class="lede">
          Small groups of kids in a narrow age band, meeting in person in San Francisco, each working on their own project from idea to finished thing.
        </p>
        <p>
          It starts with my critical thinking journal, a guided project journal each learner keeps on their own. Then the cohort: guided sessions twice a week where I teach the next skill their project needs, plus open makerspace hours to build, use the gear, and work alongside other kids doing the same.
        </p>
        <p>
          Along the way they learn to talk to strangers about their idea, write something that gets a reply, price a product, set up a store, and present with a straight back. Work is assessed against a rubric the whole way through, so "good" is never a mystery.
        </p>
        <p>
          At the end, a showcase in front of people who take it seriously. Then they go home with the thing they made.
        </p>
      </div>
    </div>
  </section>

  <section class="faq">
    <div class="wrap">
      <hr class="rule" />
      <p class="kicker faq-kicker">Parents ask</p>
      <h2>The practical stuff.</h2>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary>
              <span>{f.q}</span>
              <span class="faq-icon" aria-hidden="true">+</span>
            </summary>
            <p class="soft">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="bio">
    <div class="wrap two-col">
      <div>
        <p class="kicker">Founder</p>
        <h2>Amanda Grutza</h2>
      </div>
      <div class="stack">
        <p class="lede">Teacher, builder, born and raised New Yorker, now in San Francisco.</p>
        <p>
          On the education side, I built the design and technology program at Portfolio School in New York and most recently led tech and innovation at a school in San Francisco.
        </p>
        <p>
          On the business side, I ran ecommerce and the full tech stack at a nine-figure skincare company, have run tech for B2B and manufacturing companies, and today I work with B2B companies at the eight-figure Series B and C stage on how they build and run their technology.
        </p>
        <p>
          Almost nobody has done both, and that is why I'm the one in the room. I can look at a nine year old's idea and see what it would take to make it real, and I can teach the thinking it takes to get there.
        </p>
        <p>
          For years, parents asked me where to send a kid who wanted to build a project, an invention, or a business. There was never a good answer. AB Combinator is the answer. I'm building it in public, one cohort at a time.
        </p>
        <div class="row">
          <button type="button" class="btn primary" data-open-waitlist>Join the waitlist</button>
          <a href={base + "/"} class="btn">Back home</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .intro { padding-top: clamp(48px, 8vw, 96px); }
  .intro-inner { max-width: 760px; }
  .intro h1 { font-size: clamp(2.5rem, 7vw, 4.8rem); margin-bottom: 20px; }

  .beliefs {
    list-style: none;
    margin: clamp(32px, 5vw, 52px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
  }
  @media (min-width: 820px) { .beliefs { grid-template-columns: 1fr 1fr; column-gap: 48px; } }
  .beliefs li {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 12px;
    padding: 22px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.28);
  }
  .beliefs h3 { margin-bottom: 8px; }
  .beliefs p { margin: 0; }
  .belief-num {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.6rem;
    line-height: 1.1;
    color: var(--yellow);
    font-variation-settings: "SOFT" 60, "WONK" 1, "opsz" 72;
  }

  .faq { padding-top: 0; }
  .faq-kicker { padding-top: clamp(48px, 7vw, 80px); }
  .faq-list { margin-top: 28px; max-width: 800px; }
  .faq-item { border-top: 1px solid var(--rule); }
  .faq-item:last-child { border-bottom: 1px solid var(--rule); }
  .faq-item summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 16px 0;
    font-weight: 700;
    font-size: 17px;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-icon {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1;
    color: var(--ultra);
    flex: 0 0 auto;
    transition: transform 160ms ease;
  }
  .faq-item[open] .faq-icon { transform: rotate(45deg); }
  .faq-item p { margin: 0 0 18px; max-width: 64ch; }

  .bio { border-top: 2px solid var(--ink); }
</style>
