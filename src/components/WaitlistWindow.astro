---
import { TALLY_PARENT, TALLY_KID } from '../site.config';
const tallyUrl = (id: string) =>
  `https://tally.so/embed/${id}?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1`;
---
<div class="wl-overlay" id="waitlist" hidden aria-hidden="true">
  <div class="wl-window win" role="dialog" aria-modal="true" aria-labelledby="wl-title">
    <div class="win-bar">
      <span id="wl-title">Waitlist</span>
      <button type="button" class="win-x" data-close-waitlist aria-label="Close">×</button>
    </div>

    <div class="wl-stage" data-stage="download">
      <p class="wl-head">Checking for open spots</p>
      <div class="wl-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
        <div class="wl-fill"></div>
      </div>
      <div class="wl-log" aria-live="polite">
        <p data-line>Connecting to the cohort</p>
        <p data-line>Checking January</p>
        <p data-line class="wl-full">January is full.</p>
        <p data-line>Checking what's next</p>
        <p data-line class="wl-open">Found one waitlist. Spots are limited.</p>
      </div>
      <div class="wl-actions" hidden>
        <button type="button" class="btn small" data-close-waitlist>OK</button>
        <button type="button" class="btn small primary" data-signup>Sign up</button>
      </div>
    </div>

    <div class="wl-stage" data-stage="form" hidden>
      <p class="wl-head">Who is this for?</p>
      <div class="wl-tabs" role="tablist">
        <button type="button" role="tab" class="wl-tab" data-tab="parent" aria-selected="true">I'm a parent</button>
        <button type="button" role="tab" class="wl-tab" data-tab="kid" aria-selected="false">I'm a kid</button>
      </div>

      <div class="wl-pane" data-pane="parent" role="tabpanel">
        <p class="wl-note">About a minute. I'll email you when applications open, with dates and pricing.</p>
        {TALLY_PARENT
          ? <iframe data-tally-src={tallyUrl(TALLY_PARENT)} loading="lazy" width="100%" height="420" frameborder="0" marginheight="0" marginwidth="0" title="Parent waitlist form"></iframe>
          : <p class="wl-note">The parent form isn't connected yet.</p>}
      </div>

      <div class="wl-pane" data-pane="kid" role="tabpanel" hidden>
        <p class="wl-note">This part is for you. Tell me what you want to build, then grab a grown-up for the email bit.</p>
        {TALLY_KID
          ? <iframe data-tally-src={tallyUrl(TALLY_KID)} loading="lazy" width="100%" height="420" frameborder="0" marginheight="0" marginwidth="0" title="Kid waitlist form"></iframe>
          : <p class="wl-note">The kid form isn't connected yet.</p>}
      </div>
    </div>
  </div>
</div>

<style>
  .wl-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    padding: 20px;
    background: rgba(17, 17, 17, 0.55);
  }
  .wl-overlay[hidden] { display: none; }

  .wl-window {
    width: min(520px, 100%);
    max-height: calc(100vh - 40px);
    overflow: auto;
  }

  .wl-stage { padding: 20px; }
  .wl-head {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.4rem;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin: 0 0 14px;
    font-variation-settings: "SOFT" 60, "WONK" 1, "opsz" 72;
  }

  .wl-bar {
    height: 24px;
    border: 2px solid;
    border-color: var(--bevel-dark) var(--bevel-light) var(--bevel-light) var(--bevel-dark);
    background: var(--paper);
    padding: 2px;
  }
  .wl-fill {
    height: 100%;
    width: 0%;
    background: repeating-linear-gradient(90deg, var(--ultra) 0 10px, transparent 10px 13px);
    transition: width 240ms steps(4, end);
  }
  .wl-log {
    margin-top: 14px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink-soft);
    min-height: 7.5em;
  }
  .wl-log p { margin: 0; visibility: hidden; }
  .wl-log p.on { visibility: visible; }
  .wl-log p.wl-full.on { color: var(--ink); font-weight: 700; }
  .wl-log p.wl-open.on { color: var(--ultra); font-weight: 700; }

  .wl-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 16px;
  }
  .wl-actions[hidden] { display: none; }

  .wl-tabs { display: flex; gap: 8px; margin-bottom: 14px; }
  .wl-tab {
    flex: 1;
    padding: 10px 12px;
    border: 2px solid var(--ink);
    border-radius: 3px;
    background: var(--paper);
    color: var(--ink);
    font-weight: 700;
    font-size: 14px;
  }
  .wl-tab[aria-selected="true"] { background: var(--ultra); color: var(--paper); }
  .wl-note { font-size: 15px; color: var(--ink-soft); margin: 0 0 12px; }
  .wl-pane[hidden] { display: none; }
</style>

<script is:inline>
  (function () {
    var overlay = document.getElementById('waitlist');
    if (!overlay) return;
    var fill = overlay.querySelector('.wl-fill');
    var bar = overlay.querySelector('.wl-bar');
    var lines = overlay.querySelectorAll('[data-line]');
    var actions = overlay.querySelector('.wl-actions');
    var stages = overlay.querySelectorAll('.wl-stage');
    var timers = [];
    var lastFocus = null;

    function clearTimers() { timers.forEach(clearTimeout); timers = []; }

    function showStage(name) {
      stages.forEach(function (s) { s.hidden = s.getAttribute('data-stage') !== name; });
    }

    function runDownload() {
      clearTimers();
      showStage('download');
      actions.hidden = true;
      fill.style.width = '0%';
      bar.setAttribute('aria-valuenow', '0');
      lines.forEach(function (l) { l.classList.remove('on'); });

      // The bar stalls at "January is full" on purpose before finding the waitlist.
      var script = [
        [120, 12, 0], [420, 31, 1], [820, 44, 2], [1500, 58, 3], [1950, 81, null], [2300, 100, 4], [2650, null, 'done']
      ];
      script.forEach(function (step) {
        timers.push(setTimeout(function () {
          if (step[1] !== null) {
            fill.style.width = step[1] + '%';
            bar.setAttribute('aria-valuenow', String(step[1]));
          }
          if (typeof step[2] === 'number') lines[step[2]].classList.add('on');
          if (step[2] === 'done') {
            actions.hidden = false;
            var btn = actions.querySelector('[data-signup]');
            if (btn) btn.focus();
          }
        }, step[0]));
      });
    }

    function loadTally(pane) {
      pane.querySelectorAll('iframe[data-tally-src]').forEach(function (f) {
        if (!f.src) f.src = f.getAttribute('data-tally-src');
      });
      if (!document.querySelector('script[data-tally]')) {
        var s = document.createElement('script');
        s.src = 'https://tally.so/widgets/embed.js';
        s.async = true;
        s.setAttribute('data-tally', '1');
        document.body.appendChild(s);
      }
    }

    function open() {
      lastFocus = document.activeElement;
      overlay.hidden = false;
      overlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      runDownload();
    }

    function close() {
      clearTimers();
      overlay.hidden = true;
      overlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      if (lastFocus && lastFocus.focus) lastFocus.focus();
    }

    document.addEventListener('click', function (e) {
      var t = e.target;
      if (!t.closest) return;
      if (t.closest('[data-open-waitlist]')) { e.preventDefault(); open(); return; }
      if (t.closest('[data-close-waitlist]')) { close(); return; }
      if (t === overlay) { close(); return; }
      if (t.closest('[data-signup]')) {
        showStage('form');
        loadTally(overlay.querySelector('[data-pane="parent"]'));
        return;
      }
      var tab = t.closest('.wl-tab');
      if (tab) {
        var which = tab.getAttribute('data-tab');
        overlay.querySelectorAll('.wl-tab').forEach(function (b) {
          b.setAttribute('aria-selected', b === tab ? 'true' : 'false');
        });
        overlay.querySelectorAll('.wl-pane').forEach(function (p) {
          var on = p.getAttribute('data-pane') === which;
          p.hidden = !on;
          if (on) loadTally(p);
        });
      }
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !overlay.hidden) close();
    });

    if (location.hash === '#waitlist') open();
  })();
</script>
