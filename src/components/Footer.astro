---
import { SOCIALS } from '../site.config';
const socials = Object.entries(SOCIALS)
  .filter(([, href]) => href)
  .map(([name, href]) => ({ name, href }));
---
<footer class="footer">
  <div class="wrap footer-inner">
    <div class="footer-left">
      <p class="eyebrow">Building this in public</p>
      <p class="footer-blurb">
        I post what's working, what isn't, and what the cohort is building. Kid hands only, never faces, never names.
      </p>
      <div class="row">
        {socials.map((s) => (
          <a href={s.href} class="tag outline" target="_blank" rel="noopener">{s.name}</a>
        ))}
      </div>
    </div>
    <div class="footer-right">
      <p class="eyebrow">Get in</p>
      <button type="button" class="btn primary" data-open-waitlist>Join the waitlist</button>
      <p class="fine">San Francisco. Next cohort January 2027 (full). Waitlist open for what comes after.</p>
    </div>
  </div>
  <div class="wrap statusbar">
    <span>AB Combinator</span>
    <span>© {new Date().getFullYear()} Amanda Grutza</span>
    <span class="blink">v0.1 _</span>
  </div>
</footer>

<style>
  .footer {
    border-top: 2px solid var(--ink);
    background: var(--ultra);
    color: var(--paper);
    padding-top: clamp(48px, 7vw, 80px);
  }
  .footer-inner {
    display: grid;
    gap: 36px;
    grid-template-columns: 1fr;
    padding-bottom: 40px;
  }
  @media (min-width: 760px) {
    .footer-inner { grid-template-columns: 1.3fr 1fr; gap: 60px; }
  }
  .footer-blurb { max-width: 44ch; margin-bottom: 18px; }
  .footer .eyebrow { color: var(--yellow); }
  .footer .tag.outline { color: var(--paper); border-color: var(--paper); }
  .fine { font-size: 13px; color: rgba(255,255,255,0.75); margin-top: 16px; max-width: 36ch; }
  .statusbar {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    border-top: 1px solid rgba(255,255,255,0.25);
    padding-top: 14px;
    padding-bottom: 18px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: rgba(255,255,255,0.75);
  }
  .blink { animation: blink 1.1s steps(2, start) infinite; }
  @keyframes blink { to { visibility: hidden; } }
</style>
