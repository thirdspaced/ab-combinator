---
import { SOCIALS } from '../site.config';
const socials = Object.entries(SOCIALS)
  .filter(([, href]) => href)
  .map(([name, href]) => ({ name, href }));
const year = new Date().getFullYear();
---
<footer class="footer band">
  <div class="wrap footer-inner">
    <div>
      <h2 class="footer-title">I'm building this in public.</h2>
      <p class="footer-blurb">
        What's working, what isn't, and what the cohort is making. You'll see kids' hands and blurred work. You will never see a face or a name.
      </p>
      {socials.length > 0 && (
        <p class="footer-links">
          {socials.map((s, i) => (
            <>
              <a href={s.href} target="_blank" rel="noopener">{s.name}</a>{i < socials.length - 1 ? ' / ' : ''}
            </>
          ))}
        </p>
      )}
    </div>
    <div>
      <button type="button" class="btn primary" data-open-waitlist>Join the waitlist</button>
      <p class="footer-fine">San Francisco. The January cohort is full. The waitlist is for the one after.</p>
    </div>
  </div>
  <div class="wrap footer-bottom">
    <span>AB Combinator</span>
    <span>© {year} Amanda Grutza</span>
  </div>
</footer>

<style>
  .footer { border-bottom: 0; padding-top: clamp(48px, 7vw, 80px); }
  .footer-inner {
    display: grid;
    gap: 32px;
    grid-template-columns: 1fr;
    padding-bottom: 40px;
  }
  @media (min-width: 760px) {
    .footer-inner { grid-template-columns: 1.3fr 1fr; gap: 60px; align-items: start; }
  }
  .footer-title {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    margin-bottom: 14px;
  }
  .footer-blurb { max-width: 46ch; margin-bottom: 14px; }
  .footer-links { font-weight: 600; margin: 0; }
  .footer-fine { font-size: 14px; color: rgba(255, 255, 255, 0.82); margin-top: 14px; max-width: 34ch; }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    border-top: 1px solid rgba(255, 255, 255, 0.28);
    padding-top: 14px;
    padding-bottom: 20px;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.82);
  }
</style>
